{
  "schemaVersion": 1,
  "id": "image-attention-focus",
  "version": "0.1.0",
  "name": "图片注意力聚焦图",
  "family": "image-explanation",
  "roles": ["content", "chapter"],
  "contentKinds": ["visual-attention", "image-matching", "feature-selection", "weighted-evidence", "visual-concept"],
  "density": ["medium"],
  "motionModes": ["progressive-reveal", "focus-path", "none"],
  "maxItems": 8,
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 36},
    "query": {"type": "text", "required": true, "maxChars": 24},
    "images": {"type": "image-weight-list", "required": true, "minItems": 4, "maxItems": 8},
    "keyLabels": {"type": "label-list", "required": false, "maxItems": 8},
    "selectedValue": {"type": "selected-image-detail", "required": false},
    "takeaway": {"type": "text", "required": false, "maxChars": 100}
  },
  "themeTokens": ["text", "muted", "primary", "query", "emphasis", "line", "surface", "summarySurface"],
  "constraints": {
    "rootSelector": "[data-template=image-attention-focus]",
    "requiredSelectors": [".content-area", ".image-grid", "[data-image-item]", "[data-query]"],
    "maxImages": 8,
    "maxSteps": 4,
    "hostNavigation": "allow-after-final-step",
    "reducedMotion": "required",
    "imageZoom": "required",
    "fontUnit": "vw"
  },
  "avoid": ["需要展示完整数学公式推导", "超过8张图片且无法分组", "图片之间没有可解释的匹配或权重关系"],
  "source": {
    "originalPages": ["slide22.html", "slide23.html"],
    "sourceCourse": "AI大模型原理_安恒",
    "analysis": "第一张页面展示候选图片集合，第二张页面逐步展示 Query、Key、权重与 Value；合并为单页的四段聚焦叙事。"
  }
}
