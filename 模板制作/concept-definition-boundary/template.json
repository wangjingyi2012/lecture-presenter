{
  "schemaVersion": 1,
  "id": "concept-definition-boundary",
  "version": "0.1.0",
  "name": "概念定义与适用边界",
  "family": "basic-content",
  "roles": ["content", "reference"],
  "contentKinds": ["definition", "terminology", "principle"],
  "density": ["low", "medium"],
  "motionModes": ["none"],
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 32},
    "term": {"type": "text", "required": true, "maxChars": 24},
    "formalName": {"type": "text", "required": false, "maxChars": 54},
    "definition": {"type": "text", "required": true, "maxChars": 110},
    "attributes": {"type": "object-list", "required": true, "minItems": 2, "maxItems": 4},
    "boundary": {"type": "text", "required": true, "maxChars": 100}
  },
  "constraints": {"rootSelector": "[data-template=concept-definition-boundary]", "maxAttributes": 4, "defaultMotion": "none", "fontUnit": "vw"},
  "avoid": ["概念需要多幕推导", "包含复杂公式", "边界无法明确", "术语超过一个"]
}
