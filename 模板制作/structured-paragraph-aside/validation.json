{
  "schemaVersion": 1,
  "templateId": "structured-paragraph-aside",
  "checks": [
    {"id": "root", "selector": "[data-template=structured-paragraph-aside]", "required": true},
    {"id": "sections", "selector": "[data-section]", "min": 2, "max": 3},
    {"id": "summary", "selector": "[data-summary-item]", "min": 2, "max": 4},
    {"id": "line-length", "expression": "main-paragraph-column-width-below-58vw", "required": true},
    {"id": "no-autoplay", "expression": "no-timers-and-no-animation-loop", "required": true}
  ],
  "manualReview": ["每段只表达一个意思", "段落标题可以单独扫描", "侧栏是正文摘要而不是新增信息"]
}
