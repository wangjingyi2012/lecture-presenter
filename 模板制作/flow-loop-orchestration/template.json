{
  "schemaVersion": 1,
  "id": "flow-loop-orchestration",
  "version": "0.1.0",
  "name": "循环调度流程图",
  "family": "flow",
  "roles": ["content", "chapter"],
  "contentKinds": ["agent-loop", "tool-orchestration", "feedback-loop", "multi-step-call"],
  "density": ["medium", "high"],
  "motionModes": ["progressive-reveal", "none"],
  "maxItems": 5,
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 42},
    "lead": {"type": "text", "required": false, "maxChars": 120},
    "cycles": {"type": "flow-cycle-list", "required": true, "minItems": 1, "maxItems": 4},
    "final": {"type": "flow-node", "required": true, "maxChars": 24},
    "captions": {"type": "step-caption-list", "required": false, "maxItems": 2}
  },
  "themeTokens": ["text", "muted", "primary", "tool", "result", "final", "line", "surface"],
  "constraints": {
    "rootSelector": "[data-template=flow-loop-orchestration]",
    "requiredSelectors": [".content-area", ".flow-chart", "[data-cycle]", "[data-final-node]"],
    "maxCycles": 4,
    "maxSteps": 16,
    "hostNavigation": "allow-after-final-step",
    "reducedMotion": "required",
    "fontUnit": "vw"
  },
  "avoid": ["没有反馈回路的线性流程", "超过4轮且每轮都有长句的复杂系统", "需要同时展示多个分支决策树"],
  "source": {
    "originalPage": "slide34.html",
    "sourceCourse": "MCP协议",
    "analysis": "每轮由思考、动作、结果组成，结果通过回路返回下一轮思考，最后输出答案。"
  }
}
