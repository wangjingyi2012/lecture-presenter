{
  "schemaVersion": 1,
  "templateId": "flow-loop-orchestration",
  "checks": [
    {"id": "root", "selector": "[data-template=flow-loop-orchestration]", "required": true},
    {"id": "flow-chart", "selector": ".flow-chart", "required": true},
    {"id": "cycle-count", "selector": "[data-cycle]", "min": 1, "max": 4},
    {"id": "final-node", "selector": "[data-final-node]", "required": true},
    {"id": "feedback-connectors", "expression": "every cycle except final has a return connector", "required": true},
    {"id": "step-limit", "expression": "Number(root.dataset.maxStep) <= 16", "required": true},
    {"id": "reduced-motion", "expression": "source.includes('prefers-reduced-motion')", "required": true},
    {"id": "host-navigation", "expression": "final-step-does-not-prevent-host-navigation", "required": true},
    {"id": "no-autoplay", "expression": "no-setInterval-and-no-unbounded-animation-loop", "required": true},
    {"id": "font-units", "expression": "visible-font-size-units-use-vw-or-vh", "required": true}
  ],
  "manualReview": [
    "回路方向在投影距离下仍然清楚",
    "每轮只表达一个动作，不把多个工具塞进一个节点",
    "循环轮次超过4轮时拆成多页",
    "末步最终答案与上一轮回路有明显视觉区分"
  ]
}
