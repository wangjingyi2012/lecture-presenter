{
  "schemaVersion": 1,
  "templateId": "agent-bridge-reveal",
  "checks": [
    {"id": "root", "selector": "[data-template=agent-bridge-reveal]", "required": true},
    {"id": "content-area", "selector": ".content-area", "required": true},
    {"id": "left-actor", "selector": "[data-left-actor]", "required": true},
    {"id": "right-actor", "selector": "[data-right-actor]", "required": true},
    {"id": "bridge", "selector": "[data-bridge]", "required": true},
    {"id": "bridge-item-count", "selector": "[data-bridge-item]", "min": 1, "max": 4},
    {"id": "step-limit", "expression": "Number(root.dataset.maxStep) <= 3", "required": true},
    {"id": "reduced-motion", "expression": "source.includes('prefers-reduced-motion')", "required": true},
    {"id": "host-navigation", "expression": "final-step-does-not-prevent-host-navigation", "required": true},
    {"id": "no-autoplay", "expression": "no-setInterval-and-no-unbounded-animation-loop", "required": true},
    {"id": "responsive-fonts", "expression": "visible-font-size-units-use-vw-or-vh", "required": true}
  ],
  "manualReview": [
    "1 到 4 个桥接实现均不越出安全区",
    "标题和正文为学员可直接记忆的短句",
    "点击、方向键和宿主翻页之间没有抢夺焦点",
    "颜色 token 可由服务端 visualSystem 覆盖"
  ]
}
