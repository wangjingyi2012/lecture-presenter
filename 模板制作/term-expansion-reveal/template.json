{
  "schemaVersion": 1,
  "id": "term-expansion-reveal",
  "version": "0.1.0",
  "name": "术语展开讲解页",
  "family": "concept-reveal",
  "roles": ["content", "chapter"],
  "contentKinds": ["terminology", "acronym", "concept-introduction", "definition"],
  "density": ["low", "medium"],
  "motionModes": ["progressive-reveal", "none"],
  "maxItems": 1,
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 36},
    "term": {"type": "term-expansion", "required": true, "maxChars": 18},
    "definition": {"type": "rich-text", "required": true, "maxChars": 180},
    "example": {"type": "optional-example", "required": false, "variants": ["terminal", "code", "process", "none"]}
  },
  "themeTokens": ["text", "muted", "primary", "emphasis", "line", "surface", "terminalSurface", "terminalText"],
  "constraints": {
    "rootSelector": "[data-template=term-expansion-reveal]",
    "requiredSelectors": [".content-area", "[data-term-initials]", "[data-term-rest]", "[data-definition]"],
    "optionalSelectors": ["[data-example]", "[data-example-terminal]"],
    "maxSteps": 2,
    "hostNavigation": "allow-after-final-step",
    "reducedMotion": "required",
    "fontUnit": "vw"
  },
  "avoid": ["需要同时讲解多个术语的页面", "没有清晰全称或定义的缩写", "把命令示例当成术语定义本身"],
  "source": {
    "originalPage": "slide31.html",
    "sourceCourse": "MCP协议",
    "analysis": "缩写先保持紧凑，点击后展开完整术语和定义；本页额外展示一个终端示例，但示例区不是模板必需部分。"
  }
}
