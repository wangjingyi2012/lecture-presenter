{
  "schemaVersion": 1,
  "templateId": "term-expansion-reveal",
  "checks": [
    {"id": "root", "selector": "[data-template=term-expansion-reveal]", "required": true},
    {"id": "term-initials", "selector": "[data-term-initials]", "required": true},
    {"id": "term-rest", "selector": "[data-term-rest]", "required": true},
    {"id": "definition", "selector": "[data-definition]", "required": true},
    {"id": "optional-example", "expression": "example is absent or example.kind is one of terminal/code/process", "required": true},
    {"id": "step-limit", "expression": "Number(root.dataset.maxStep) <= 2", "required": true},
    {"id": "reduced-motion", "expression": "source.includes('prefers-reduced-motion')", "required": true},
    {"id": "host-navigation", "expression": "final-step-does-not-prevent-host-navigation", "required": true},
    {"id": "no-autoplay", "expression": "no-setInterval-and-no-unbounded-animation-loop", "required": true},
    {"id": "font-units", "expression": "visible-font-size-units-use-vw-or-vh", "required": true},
    {"id": "content-area-overflow", "expression": "content-area-does-not-use-overflow-hidden; term-rest-clipping-is-allowed", "required": true}
  ],
  "manualReview": [
    "没有 example 时，定义仍然独立完整，不留下空白占位",
    "有 example 时，示例服务于定义，不重复整段解释",
    "全称展开后不越出内容安全区",
    "最后一步之后方向键可以交还宿主演示器"
  ]
}
