{
  "schemaVersion": 1,
  "id": "parameter-result-space",
  "version": "0.1.0",
  "name": "参数控制与结果空间",
  "family": "interactive-explanation",
  "roles": ["content", "demo"],
  "contentKinds": ["parameter-effect", "threshold", "top-k", "filtering", "interactive-model"],
  "density": ["medium"],
  "motionModes": ["interactive-control", "progressive-reveal", "none"],
  "maxItems": 12,
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 36},
    "lead": {"type": "text", "required": false, "maxChars": 100},
    "controls": {"type": "numeric-control-list", "required": true, "minItems": 1, "maxItems": 2},
    "points": {"type": "point-list", "required": true, "minItems": 6, "maxItems": 12},
    "resultLimit": {"type": "integer", "required": false, "min": 3, "max": 6},
    "takeaway": {"type": "text", "required": false, "maxChars": 90}
  },
  "themeTokens": ["text", "muted", "primary", "selected", "caution", "line", "surface", "spaceSurface"],
  "constraints": {
    "rootSelector": "[data-template=parameter-result-space]",
    "requiredSelectors": [".content-area", ".parameter-stage", "[data-control]", "[data-point]", "[data-result-list]"],
    "maxControls": 2,
    "maxPoints": 12,
    "hostNavigation": "page-only-while-control-focused",
    "reducedMotion": "required",
    "fontUnit": "vw"
  },
  "avoid": ["需要精确科研绘图", "超过12个点或多个数据系列", "参数变化没有可解释结果", "结果只能通过复杂后端计算获得"],
  "source": {
    "originalPage": "知识库搭建/slide18.html",
    "analysis": "左侧控制参数，中间空间实时改变选中范围，右侧同步更新排序结果和解释。"
  }
}
