{
  "schemaVersion": 1,
  "id": "key-message-evidence",
  "version": "0.1.0",
  "name": "核心结论与支撑依据",
  "family": "basic-content",
  "roles": ["content", "summary"],
  "contentKinds": ["key-message", "argument", "recommendation"],
  "density": ["low", "medium"],
  "motionModes": ["none"],
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 32},
    "lead": {"type": "text", "required": false, "maxChars": 70},
    "message": {"type": "text", "required": true, "maxChars": 72},
    "evidence": {"type": "object-list", "required": true, "minItems": 2, "maxItems": 4},
    "takeaway": {"type": "text", "required": false, "maxChars": 76}
  },
  "constraints": {
    "rootSelector": "[data-template=key-message-evidence]",
    "maxEvidenceItems": 4,
    "defaultMotion": "none",
    "fontUnit": "vw"
  },
  "avoid": ["多步骤流程", "需要逐项比较", "超过四组依据", "结论尚未明确"]
}
