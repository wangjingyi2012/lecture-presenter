    "features": {"type": "labeled-item-list", "required": true, "minItems": 2, "maxItems": 4},
    "mechanism": {"type": "process-node-list", "required": true, "minItems": 3, "maxItems": 5},
    "conclusion": {"type": "text", "required": true, "maxChars": 80},
    "boundary": {"type": "text", "required": false, "maxChars": 90}
