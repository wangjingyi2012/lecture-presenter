{
  "schemaVersion": 1,
  "templateId": "flow-command-breakdown",
  "checks": [
    {"id": "root", "selector": "[data-template=flow-command-breakdown]", "required": true},
    {"id": "outer-flow", "selector": "[data-outer-flow]", "required": true},
    {"id": "command-detail", "selector": ".command-detail", "required": true},
    {"id": "command-parts", "selector": "[data-command-part]", "min": 2, "max": 4},
    {"id": "step-limit", "expression": "Number(root.dataset.maxStep) <= 12", "required": true},
    {"id": "same-canvas", "expression": "command-detail-does-not-reflow-outer-flow", "required": true},
    {"id": "reduced-motion", "expression": "source.includes('prefers-reduced-motion')", "required": true},
    {"id": "host-navigation", "expression": "final-step-does-not-prevent-host-navigation", "required": true},
    {"id": "no-autoplay", "expression": "no-setInterval-and-no-unbounded-animation-loop", "required": true},
    {"id": "font-units", "expression": "visible-font-size-units-use-vw-or-vh", "required": true}
  ],
  "manualReview": [
    "命令高亮与解释文本始终对应同一部分",
    "命令面板不会覆盖标题、结论或外层流程节点",
    "不同长度的命令仍然保持可读字号",
    "无命令拆解需求时应选择普通流程模板"
  ]
}
