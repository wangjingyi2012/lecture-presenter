{
  "schemaVersion": 1,
  "id": "table-reference-catalog",
  "version": "0.1.0",
  "name": "参考目录型表格",
  "family": "table",
  "roles": ["content", "reference"],
  "contentKinds": ["catalog", "reference", "capability-index", "tool-list", "resource-list"],
  "density": ["medium", "high"],
  "motionModes": ["none"],
  "maxItems": 8,
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 36},
    "lead": {"type": "text", "required": false, "maxChars": 110},
    "columns": {"type": "column-list", "required": true, "minItems": 3, "maxItems": 5},
    "rows": {"type": "catalog-row-list", "required": true, "minItems": 2, "maxItems": 8}
  },
  "themeTokens": ["text", "muted", "primary", "line", "surface", "headerText", "codeSurface"],
  "constraints": {
    "rootSelector": "[data-template=table-reference-catalog]",
    "requiredSelectors": [".content-area", ".catalog-table", "[data-catalog-row]"],
    "maxRows": 8,
    "hostNavigation": "page-only",
    "reducedMotion": "not-applicable",
    "fontUnit": "vw"
  },
  "avoid": ["需要逐项比较优缺点的方案选型", "超过8行且不能拆页的长目录", "每个单元格都是长段落的说明文档"],
  "source": {
    "originalPage": "slide13.html",
    "sourceCourse": "MCP协议",
    "analysis": "首列承担对象名称与一句话说明，后续列按能力类别列出接口、资源或提示。"
  }
}
