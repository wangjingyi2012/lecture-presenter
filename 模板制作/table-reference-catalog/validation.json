{
  "schemaVersion": 1,
  "templateId": "table-reference-catalog",
  "checks": [
    {"id": "root", "selector": "[data-template=table-reference-catalog]", "required": true},
    {"id": "content-area", "selector": ".content-area", "required": true},
    {"id": "table", "selector": ".catalog-table", "required": true},
    {"id": "row-count", "selector": "[data-catalog-row]", "min": 2, "max": 8},
    {"id": "column-count", "expression": "columns.length >= 3 && columns.length <= 5", "required": true},
    {"id": "font-units", "expression": "visible-font-size-units-use-vw-or-vh", "required": true},
    {"id": "no-hidden-overflow", "expression": "template-does-not-use-overflow-hidden", "required": true}
  ],
  "manualReview": [
    "首列名称和说明在投影距离下可快速扫描",
    "单元格内容保持短语化，长内容拆页而不是缩小字号",
    "代码、URI 等窄字段没有把表格撑破安全区",
    "空值统一使用短横线或由服务端视觉系统指定的空状态"
  ]
}
