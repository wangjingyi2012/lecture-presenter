{
  "schemaVersion": 1,
  "id": "case-facts-conclusion",
  "version": "0.1.0",
  "name": "案例事实与分析结论",
  "family": "basic-content",
  "roles": ["content", "case-study"],
  "contentKinds": ["case", "incident", "business-example"],
  "density": ["medium"],
  "motionModes": ["none"],
  "slots": {
    "title": {"type": "text", "required": true, "maxChars": 38},
    "lead": {"type": "text", "required": true, "maxChars": 90},
    "facts": {"type": "object-list", "required": true, "minItems": 3, "maxItems": 5},
    "analysisTitle": {"type": "text", "required": true, "maxChars": 28},
    "analysis": {"type": "text", "required": true, "maxChars": 180},
    "lesson": {"type": "text", "required": true, "maxChars": 90}
  },
  "constraints": {"rootSelector": "[data-template=case-facts-conclusion]", "maxFacts": 5, "factAndAnalysisSeparated": true, "defaultMotion": "none", "fontUnit": "vw"},
  "avoid": ["事实来源不明确", "需要完整时间线", "分析结论超过180字", "案例只有观点没有事实"]
}
